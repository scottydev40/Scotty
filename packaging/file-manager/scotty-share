#!/usr/bin/env bash
# Hand the selected files/folders to Scotty's send sheet.
#
# Invoked by the file-manager integrations (Nautilus extension/script, DING
# desktop menu). Works whether Scotty is installed natively (a `scotty` on PATH)
# or as a Flatpak.
#
# Native: folders are passed through unchanged — Scotty compresses each into a
# single archive itself at its send choke point.
#
# Flatpak: files are forwarded through the document portal (--file-forwarding +
# @@) so the sandbox can read a selection anywhere on disk, not only the folders
# it was granted at install time. A *directory* cannot cross that boundary — the
# portal forwards file fds, and a directory fd is rejected ("Invalid fd passed").
# So a selected folder is zipped to a temp archive here and the archive (a file)
# is forwarded instead. Same end result as the native path: the receiver gets
# one .zip per folder.
set -euo pipefail

FLATPAK_ID="dev.scotty.Scotty"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Scotty" "$1"
    else
        printf 'Scotty: %s\n' "$1" >&2
    fi
}

# Collect the selection. In a Nautilus script the positional arguments are bare
# file names, while NAUTILUS_SCRIPT_SELECTED_FILE_PATHS holds absolute paths, so
# prefer that env var when it is set; otherwise (DING desktop menu, CLI) the
# arguments are already absolute paths.
paths=()
if [ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]; then
    while IFS= read -r line; do
        [ -n "$line" ] && paths+=("$line")
    done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
else
    paths=("$@")
fi

# Drop blanks and non-existent entries.
selection=()
for p in "${paths[@]}"; do
    [ -n "$p" ] && [ -e "$p" ] && selection+=("$p")
done

if [ "${#selection[@]}" -eq 0 ]; then
    notify "Nothing selected to share."
    exit 1
fi

if command -v scotty >/dev/null 2>&1; then
    exec scotty --send "${selection[@]}"
elif command -v flatpak >/dev/null 2>&1 \
        && flatpak info "$FLATPAK_ID" >/dev/null 2>&1; then
    # A directory cannot be forwarded to the sandbox, so replace each selected
    # folder with a temp .zip of it and forward that. Plain files pass through.
    forward=()
    zip_root=""
    for p in "${selection[@]}"; do
        if [ -d "$p" ]; then
            if ! command -v zip >/dev/null 2>&1; then
                notify "The 'zip' tool is needed to share a folder."
                exit 1
            fi
            [ -n "$zip_root" ] || zip_root="$(mktemp -d "${TMPDIR:-/tmp}/scotty-share-XXXXXX")"
            name="$(basename -- "$p")"
            [ -n "$name" ] && [ "$name" != "/" ] || name="folder"
            # A fresh subdir per folder: `zip` appends to an existing archive, so
            # the destination must not pre-exist, and two folders may share a name.
            out_dir="$zip_root/${#forward[@]}"
            mkdir -p "$out_dir"
            archive="$out_dir/$name.zip"
            # Run from the parent so the archive stores `name/…`, not absolute paths.
            if ( cd "$(dirname -- "$p")" && zip -r -q "$archive" "$name" ) \
                    && [ -f "$archive" ]; then
                forward+=("$archive")
            else
                notify "Could not compress the folder \"$name\"."
            fi
        else
            forward+=("$p")
        fi
    done
    if [ "${#forward[@]}" -eq 0 ]; then
        notify "Nothing to share."
        exit 1
    fi
    # --send is an app argument (Scotty enters send mode only with it); it goes
    # before the @@ block so flatpak passes it through literally.
    exec flatpak run --file-forwarding "$FLATPAK_ID" --send @@ "${forward[@]}" @@
else
    notify "Scotty is not installed."
    exit 1
fi
