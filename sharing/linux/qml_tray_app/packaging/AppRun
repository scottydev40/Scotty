#!/usr/bin/env bash
set -e

HERE="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"

# shellcheck source=scotty-install-lib.sh
source "$HERE/scotty-install-lib.sh"

# --- uninstall (user-level; leaves the shared BlueZ system config in place) --
if [[ -z "${SCOTTY_SKIP_SETUP:-}" && "${1:-}" == "--uninstall" ]]; then
  scotty_uninstall
  echo "[scotty] Uninstalled (BlueZ system config left in place). Log out/in to clear the tile from the current session." >&2
  exit 0
fi

# --- first-run privileged setup (BlueZ "combined recipe") -------------------
# Nearby needs Experimental=true + a bluetoothd `--noplugin=mcp` drop-in. Those
# are system-level and can't be done from an unprivileged app, so on first run we
# elevate once via pkexec. Skip silently if it's already applied.
recipe_ok() {
  grep -qiE '^[[:space:]]*Experimental[[:space:]]*=[[:space:]]*true' \
    /etc/bluetooth/main.conf 2>/dev/null || return 1
  local pid cmd
  pid="$(systemctl show bluetooth -p MainPID --value 2>/dev/null || true)"
  [[ -n "$pid" && "$pid" != 0 ]] || return 1
  cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"
  [[ "$cmd" == *--noplugin=mcp* ]]
}

if [[ -z "${SCOTTY_SKIP_SETUP:-}" ]] && ! recipe_ok; then
  # Copy the setup out of the (root-unreadable) AppImage FUSE mount first.
  SETUP_SRC="$HERE/usr/bin/scotty-setup"
  SETUP_DST="${XDG_CACHE_HOME:-$HOME/.cache}/scotty/scotty-setup.sh"
  mkdir -p "$(dirname "$SETUP_DST")"
  cp -f "$SETUP_SRC" "$SETUP_DST" 2>/dev/null || true
  if command -v pkexec >/dev/null 2>&1; then
    echo "[scotty] First run: applying Bluetooth setup (password prompt)…" >&2
    pkexec bash "$SETUP_DST" \
      || echo "[scotty] Setup skipped/failed; re-run: sudo bash $SETUP_DST" >&2
  else
    echo "[scotty] Run once to enable Nearby: sudo bash $SETUP_DST" >&2
  fi
fi

# --- first-run GNOME Quick Settings tile (user-level, no root) --------------
EXT_UUID="quickshare@ashpika40.github.io"
EXT_SRC="$HERE/usr/share/scotty/gnome-extension"
EXT_DST="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-shell/extensions/$EXT_UUID"
if [[ -z "${SCOTTY_SKIP_SETUP:-}" && -d "$EXT_SRC" && ! -d "$EXT_DST" ]] \
   && command -v gnome-shell >/dev/null 2>&1; then
  echo "[scotty] Installing GNOME Quick Settings tile…" >&2
  mkdir -p "$EXT_DST"
  cp -a "$EXT_SRC/." "$EXT_DST/"
  command -v gnome-extensions >/dev/null 2>&1 && gnome-extensions enable "$EXT_UUID" 2>/dev/null || true
  echo "[scotty] Tile installed — open it from Quick Settings." >&2
fi

# --- first-run self-install as a background service + hand-off ---------------
# A bare launch (no SCOTTY_SKIP_SETUP) installs Scotty as a systemd --user
# service, then exits and returns the terminal — single-instance means running
# the app here would just exit anyway. The service invocation below carries
# SCOTTY_SKIP_SETUP=1 and falls through to the real foreground app.
if [[ -z "${SCOTTY_SKIP_SETUP:-}" ]]; then
  SELF="$(scotty_self_path)"
  DESKTOP_SRC="$HERE/usr/share/applications/dev.scotty.Scotty.desktop"
  ICON_SRC="$HERE/usr/share/icons/hicolor/256x256/apps/dev.scotty.Scotty.png"
  STATE="$(scotty_install_or_update "$SELF" "$DESKTOP_SRC" "$ICON_SRC")"
  case "$STATE" in
    installed)
      echo "[scotty] Installed as a background service. Open it from your app grid or the GNOME Quick-Settings tile." >&2
      systemctl --user start scotty.service 2>/dev/null || true
      exit 0
      ;;
    updated)
      echo "[scotty] Updated the installed copy and restarted the service." >&2
      exit 0
      ;;
    current)
      # Already installed — this is the user opening the app (double-click /
      # "Send with Scotty"). Fall through and run it; single-instance hands the
      # request (and any file args) to the running service instance.
      :
      ;;
  esac
fi

export LD_LIBRARY_PATH="$HERE/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="$HERE/usr/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/plugins/platforms"
export QML2_IMPORT_PATH="$HERE/usr/qml"
export QML_IMPORT_PATH="$HERE/usr/qml"
# Prefer Wayland, fall back to X11.
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"

exec "$HERE/usr/bin/scotty" "$@"
