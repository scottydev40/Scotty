<RCC>
  <qresource prefix="/qml">
    <file>FileShareTray.qml</file>
    <file>components/AppHeader.qml</file>
    <file>components/SideBar.qml</file>
    <file>components/AnimatedBlob.qml</file>
    <file>components/SendUrlPanel.qml</file>
    <file>components/DeviceRow.qml</file>
    <file>components/SettingsPanel.qml</file>
  </qresource>
  <qresource prefix="/icons">
    <file>tray_icon.png</file>
    <file alias="dev_generic.svg">icons/dev_generic.svg</file>
    <file alias="dev_laptop.svg">icons/dev_laptop.svg</file>
    <file alias="dev_phone.svg">icons/dev_phone.svg</file>
    <file alias="dev_tablet.svg">icons/dev_tablet.svg</file>
    <file alias="check_double.svg">icons/check_double.svg</file>
    <file alias="gear.svg">icons/gear.svg</file>
    <file alias="app_swap.svg">icons/app_swap.svg</file>
    <file alias="app_icon.svg">icons/app_icon.svg</file>
  </qresource>
</RCC>
