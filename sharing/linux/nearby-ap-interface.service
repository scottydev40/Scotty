[Unit]
# Creates the AP-mode virtual interface the hotspot medium hosts on.
#
# NetworkManager allows one active connection per device, so activating the
# hotspot on the Wi-Fi device disconnects the machine from its network for the
# duration of a transfer. A second AP-mode interface is a separate device, so
# both run at once and the Wi-Fi connection survives.
#
# Creating it needs CAP_NET_ADMIN, which the app does not have, hence this unit.
# The interface sits idle and downed until a transfer needs it.
#
# Install:
#   sudo cp nearby-ap-interface.service /etc/systemd/system/
#   sudo systemctl enable --now nearby-ap-interface.service
#
# Set WIFI_INTERFACE below if the device is not wlan0/wlp*.
Description=AP-mode virtual interface for Nearby file sharing
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# `__ap` is the AP-mode virtual interface type; `iw help` does not list it.
ExecStart=/bin/sh -c 'iface="${WIFI_INTERFACE:-$(iw dev | awk "/Interface/ {print \\$2; exit}")}"; \
  [ -e /sys/class/net/nearby-ap0 ] || iw dev "$iface" interface add nearby-ap0 type __ap'
ExecStop=/bin/sh -c '[ -e /sys/class/net/nearby-ap0 ] && iw dev nearby-ap0 del || true'

[Install]
WantedBy=multi-user.target
